{
  "name": "wishing-star",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Amelia and the Wishing Star: a top-down open-world quest game for the browser, made as a Christmas present.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tools tests",
    "format": "biome check --write src tools tests",
    "test": "vitest run",
    "map": "node tools/map/build.ts",
    "ground": "node tools/map/bake.ts",
    "art": "node tools/art/cli.ts",
    "check": "node tools/check/validate.ts",
    "solve": "node tools/check/solver.ts",
    "smoke": "node tools/bot/smoke.ts",
    "frames": "node tools/bot/framegate.ts",
    "soak": "node tools/bot/soak.ts",
    "release": "node tools/release/build.ts",
    "verify": "node tools/verify.ts"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "phaser": "3.90.0",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
